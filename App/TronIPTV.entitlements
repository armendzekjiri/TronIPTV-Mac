<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed for both the Mac App Store and the notarized DMG. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Playlists, guides, logos and streams from the user's providers. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Local M3U files the user picks, reopened after relaunch through security-scoped bookmarks. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
